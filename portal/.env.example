APP_NAME="DZD Ad Network"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Colombo
APP_URL=http://localhost:8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite by default — zero config for local dev.
# For production use mysql and fill the credentials below.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dzd_portal
# DB_USERNAME=dzd
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@dzd-ads.lk"
MAIL_FROM_NAME="${APP_NAME}"

# ---- DZD portal settings (used across the site) ----
DZD_CONTACT_EMAIL=hello@dzd-marketing.site
DZD_WHATSAPP="+94700000000"
DZD_SMM_PANEL_URL=https://dzd-marketing.site
DZD_ADSERVER_URL=http://localhost:8080
